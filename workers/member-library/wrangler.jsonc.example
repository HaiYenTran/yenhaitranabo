{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yen-tran-member-library",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "yenhaitran.com/member-api/*",
      "zone_name": "yenhaitran.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yen-tran-members",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEMBER_FILES",
      "bucket_name": "yen-tran-member-files"
    }
  ]
}
